{
  "name": "dice-maniac-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dice Maniac for Windows",
  "author": "Dice Maniac",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "com.dicemaniac.desktop",
    "productName": "Dice Maniac",
    "artifactName": "Dice-Maniac-Setup-${version}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "connect.html",
      "connect.cjs"
    ],
    "win": {
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
